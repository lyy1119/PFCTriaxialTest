history purge

[xlength = 0]
[ylength = 0]
[zlength = 0]
fish define xlength
    local dimensions = get_vessel_dimensions(walls)
    xlength = dimensions('x')
    ylength = dimensions('y')
    zlength = dimensions('z')
end

; record length
history fish @xlength
history fish @ylength
history fish @zlength

[xlength0 = xlength]
[ylength0 = ylength]
[zlength0 = zlength]

[xEpsilon = 0]
[yEpsilon = 0]
[zEpsilon = 0]

fish define xEpsilon
    xEpsilon = (xlength - xlength0)/xlength0
    yEpsilon = (ylength - ylength0)/ylength0
    zEpsilon = (zlength - zlength0)/zlength0
end

; record epsilon
history fish @xEpsilon
history fish @yEpsilon
history fish @zEpsilon

[xStress = 0]
[yStress = 0]
[zStress = 0]
fish define xStress
    local stress = get_wall_stress(walls)
    xStress = stress('x')
    yStress = stress('y')
    zStress = stress('z')
end

history fish @xStress
history fish @yStress
history fish @zStress ; [stress('z')] is this ok?

[aratio = 0]
fish define aratio
    aratio = mech.solve("ratio-average")
end

history fish @aratio