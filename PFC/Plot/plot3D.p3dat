plot create
plot clear
plot active on
plot target active on
plot background 'white'
plot outline active on width 2 color 'black'
plot legend active on heading color 'black' copyright color 'black' ...
    placement left size 25,50 ...
    step active off ...
    time-real active off ...
    time-model active off ...
    title-customer active off ...
    view-info active off
plot title-job active off
plot title active off
plot view projection perspective magnification 1 ...
    center (-0.384725,0.0318694,-2.83171) eye (28.6269,19.5686,4.60907) roll 0.3552 ...
    clip-front -1e+10 clip-back 1e+10
plot item create wall active on ...
    shape facet ...
        shrink-factor target 0.05 value 1 ...
        polygons fill on outline active on width 1 color 'black' ...
            polygon-transparency 0 ...
            outline-transparency 80 lighting on offset 0.5 2 ...
            cut-line width 1 ...
    color-by "default" ...
    color-options named ...
        maximum-names 1000000 ...
        name-controls true ...
        colors global off clear  ...
            label "facets" active on color 'seagreen' ...
    display ...
        "polygonWall1000" true ...
        "polygonWall1001" true ...
        "polygonWall1002" true ...
        "polygonWall1003" true ...
        "polygonWall1004" true ...
        "polygonWall1005" true ...
        "boxWall1" true ...
    map axis xyz translate (0,0,0) scale (1,1,1) ...
    transparency 70 ...
    cut active off ...
    clip active off ...
    legend active on ...
        title active on text "" size 55 family 'Times New Roman' style bold color 'black' ...
        count active on size 44 family 'Arial' style normal color 'black' ...
        named label active on size 44 family 'Arial' style normal color 'black' ...
        scaled labels active on size 44 family 'Arial' style normal color 'black' ...
            labels-maximum 20
plot item create clump active on ...
    shape pebble ...
        shrink-factor target 0.05 value 1 pixel-size 5 quality 8 ...
    color-by "default" ...
    color-options named ...
        maximum-names 1000000 ...
        name-controls true ...
        colors global off clear  ...
            label "clump" active on color 'seagreen' ...
    orientation false color 'black' size 10 normal (1,0,0) ...
    map axis xyz translate (0,0,0) scale (1,1,1) ...
    transparency 0 ...
    cut active off ...
    clip active off ...
    legend active on ...
        title active on text "" size 55 family 'Times New Roman' style bold color 'black' ...
        count active on size 44 family 'Arial' style normal color 'black' ...
        named label active on size 44 family 'Arial' style normal color 'black' ...
        scaled labels active on size 44 family 'Arial' style normal color 'black' ...
            labels-maximum 20
plot item create domain active on color-list global off clear  ...
        label "Stop" color 'seagreen' ...
        label "Reflect" color 'red' ...
        label "Destroy" color 'pink' ...
        label "Periodic" color 'orange' ...
    polygons fill on outline active on width 1 color 'black' ...
    polygon-transparency 0 ...
    outline-transparency 80 lighting on offset 0.5 2 ...
    cut-line width 1 ...
    transparency 90 ...
    clip active off ...
    legend active on ...
        title active on text "" size 55 family 'Times New Roman' style bold color 'black' ...
         color-list label active on size 44 family 'Arial' style normal color 'black' ...
        heading active on text "" size 44 family 'Arial' style normal color 'black' ...
        count active off
plot item create axes active on ...
    axis-x color 'red' draw-positive on draw-negative off label-positive 'X' ...
    axis-y color 'lime' draw-positive on draw-negative off label-positive 'Y' ...
    axis-z color 'blue' draw-positive on draw-negative off label-positive 'Z' ...
    screen 10 10 scale 5 ...
    font size 10 family 'Arial' style bold ...
    transparency 0 ...
    legend active off
