; ========================== generate particles ==========================

; clump definition
clump template create name 'particle'   ...
    pebbles 2                           ...
    [ball1Radius] [-distance*0.5] 0 0    ...
    @ball2Radius [distance*0.5 ] 0 0    ...
    pebcalculate 0.005


[walls = init_wall]
[extend_wall(walls, 2)]
@init_clumps([domainSize*0.25], "particle", [porosity], [rMax], [rMin])
; Activate gravity
model gravity 0.0

model cycle 1000 calm 50
model mechanical timestep scale
model solve ratio-average 1e-5
model mechanical timestep auto
model cycle 2000
model solve ratio-average 1e-5

; Save the initial state
model save '../'
; =================================================================