; load dependencies code
program call 'PFC/Lib/vessel.fis'

; =====================================wall generation=====================================
define create_rect_wall(v1, v2, v3, v4)
    ; init wall id
    if next_wall_id = 0 then
        global next_wall_id = 1000
    endif

    local current_id = next_wall_id

    command
        wall generate id [current_id]       ...
            polygon                         ...
                @v1(1,1) @v1(1,2) @v1(1,3)  ...
                @v2(1,1) @v2(1,2) @v2(1,3)  ...
                @v3(1,1) @v3(1,2) @v3(1,3)  ...
                @v4(1,1) @v4(1,2) @v4(1,3)  ...

    endcommand

    next_wall_id = next_wall_id + 1 ; make sure wall id is unique
    current_wall = wall.find(current_id)
    create_rect_wall = current_wall ; function name itself is THE return value
end

define vertices ; sorted by octant
    local a = domainSize/4.0

    p1(1,1) =  a/2
    p1(1,2) =  a/2
    p1(1,3) =  a

    p2(1,1) = -a/2
    p2(1,2) =  a/2
    p2(1,3) =  a

    p3(1,1) = -a/2
    p3(1,2) = -a/2
    p3(1,3) =  a

    p4(1,1) =  a/2
    p4(1,2) = -a/2
    p4(1,3) =  a

    p5(1,1) =  a/2
    p5(1,2) =  a/2
    p5(1,3) = -a

    p6(1,1) = -a/2
    p6(1,2) =  a/2
    p6(1,3) = -a

    p7(1,1) = -a/2
    p7(1,2) = -a/2
    p7(1,3) = -a

    p8(1,1) =  a/2
    p8(1,2) = -a/2
    p8(1,3) = -a
end

define init_wall
    p1 = array.create(1, 3)
    p2 = array.create(1, 3)
    p3 = array.create(1, 3)
    p4 = array.create(1, 3)
    p5 = array.create(1, 3)
    p6 = array.create(1, 3)
    p7 = array.create(1, 3)
    p8 = array.create(1, 3)

    vertices()

    walls = map()

    walls('front')  = create_rect_wall(p1, p5, p8, p4) ; point to (0, 0, 0)
    walls('back')   = create_rect_wall(p2, p3, p7, p6)
    walls('right')  = create_rect_wall(p1, p2, p6, p5)
    walls('left')   = create_rect_wall(p3, p4, p8, p7)
    walls('up')     = create_rect_wall(p4, p3, p2, p1)
    walls('down')   = create_rect_wall(p5, p6, p7, p8)

    init_wall = walls
end
; =========================================================================================

; =========================================================================================
define init_clumps(extent, clumpName, porosity, dMax, dMin)
    local e = extent
    command
        clump distribute            ...
            size [(4.0/3.0)*(dMin/2)^3*math.pi] [(4.0/3.0)*(dMax/2)^3*math.pi] ...
            template [clumpName]    ...
            porosity [porosity]     ...
            box [-extent/2.0+dMax/2] [extent/2.0-dMin/2] [-extent/2.0+dMax/2] [extent/2.0-dMin/2] [-extent+dMax/2] [extent-dMin]


        clump attribute             ...
            damp 0.7                ...
            density [density]

        clump property              ...
            "fric"    [clumpFric]

        wall property "fric" [wallFric]
    endcommand
end
; =========================================================================================