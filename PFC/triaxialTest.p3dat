; ===========================traxial test=========================
; [epsilonRate = ] ; set by python

program call 'PFC/inspection.p3dat'

model calm ; stable all clumps
[servos('x') = true]
[servos('y') = true]
[servos('z') = false]

[wall.vel.z(walls('up'))   = -epsilonRate*zlength/2.0]
[wall.vel.z(walls('down')) =  epsilonRate*zlength/2.0]

[stop_judgement = 0]
fish define stop_judgement
    if zEpsilon <= -0.20 then ; variable zEpsilon relay on 'inspection.p3dat'
        stop_judgement = 1
    else
        stop_judgement = 0
    endif
end

; should call inspection first
model solve fish-halt @stop_judgement
; model cycle 800000
; ==============================================